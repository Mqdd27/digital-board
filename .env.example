# Postgres connection string. Required.
DATABASE_URL=postgres://board:password@localhost:5432/board

# Where uploaded chat attachments are stored. Defaults to ./uploads.
# Point this at a persistent volume in Docker, and at shared storage if you
# ever run more than one instance.
# UPLOAD_DIR=/var/lib/digital-board/uploads

# Pool size. Default 10.
# DATABASE_POOL_MAX=10

# Next.js listens on 3000 by default.
# PORT=3000

# Timezone used to render timestamps — they are formatted server-side.
# TZ=Asia/Jakarta
